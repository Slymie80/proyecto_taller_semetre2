def mostrar_titulo(texto):
    print(f"{CYAN}{'=' * 55}")
    print(f"  {texto}")
    print(f"{'=' * 55}{RESET}")


def seleccionar_opcion(opciones, mensaje):
    while True:
        print(mensaje)
        for i, opcion in enumerate(opciones, 1):
            print(f"{i}. {opcion}")
        seleccion = input("Seleccione una opción: ").strip()
        if seleccion.isdigit() and 1 <= int(seleccion) <= len(opciones):
            return int(seleccion)
        print(f"{ROJO}Opción inválida. Intente nuevamente.{RESET}")


def leer_entero(mensaje, minimo, maximo):
    while True:
        texto = input(mensaje).strip()
        if texto.isdigit() and minimo <= int(texto) <= maximo:
            return int(texto)
        print(f"{ROJO}Entrada inválida. Debe ser un entero entre {minimo} y {maximo}.{RESET}")


def leer_peso(mensaje):
    while True:
        texto = input(mensaje).strip().replace(",", ".")
        if texto.replace(".", "", 1).isdigit() and float(texto) > 0:
            return float(texto)
        print(f"{ROJO}Peso inválido. Debe ser un número mayor que 0.{RESET}")


def leer_texto(mensaje):
    while True:
        texto = input(mensaje).strip()
        if texto != "":
            return texto
        print(f"{ROJO}Este campo no puede estar vacío.{RESET}")


def color_bateria(bateria):
    if bateria < 20:
        return ROJO
    if bateria < 50:
        return AMARILLO
    return VERDE

def buscar_pedido(id_pedido):
    for pedido in pedidos:
        if pedido["id"] == id_pedido:
            return pedido
    return None


def buscar_vehiculo(id_vehiculo):
    if id_vehiculo in flota:
        return flota[id_vehiculo]
    return None


def buscar_pedido_por_vehiculo(id_vehiculo):
    for pedido in pedidos:
        if pedido["vehiculo"] == id_vehiculo and pedido["estado"] == "En Ruta":
            return pedido
    return None


def vehiculo_disponible(id_vehiculo):
    if id_vehiculo in flota and flota[id_vehiculo]["estado"] == "Disponible":
        return True
    return False


def vehiculo_bloqueado_por_clima(id_vehiculo):
    tipo_bloqueado = restricciones.get(clima_actual)
    return tipo_bloqueado is not None and flota[id_vehiculo]["tipo"] == tipo_bloqueado


def registrar_consumo(id_vehiculo, cantidad):
    bateria = flota[id_vehiculo]["bateria"]
    if cantidad > bateria:
        cantidad = bateria
    flota[id_vehiculo]["bateria"] = bateria - cantidad
    estadisticas_vehiculos[id_vehiculo]["energia_consumida"] += cantidad
    consumo_acumulado[flota[id_vehiculo]["tipo"]] += cantidad
    return cantidad

def registrar_visualizar_pedidos():
    opcion = seleccionar_opcion(["Registrar pedido", "Visualizar pedidos"],
                                "Qué desea hacer?")
    if opcion == 1:
        id_pedido = 1
        for pedido in pedidos:
            if pedido["id"] >= id_pedido:
                id_pedido = pedido["id"] + 1
        destino = leer_texto("Ingrese el destino del pedido: ")
        peso = leer_peso("Ingrese el peso del pedido (kg): ")
        prioridad = leer_entero("Ingrese la prioridad del pedido (1-5): ", 1, 5)
        pedidos.append({
            "id": id_pedido,
            "destino": destino,
            "peso": peso,
            "prioridad": prioridad,
            "estado": "Pendiente",
            "vehiculo": None
        })
        print(f"{VERDE}Pedido registrado exitosamente con ID {id_pedido}.{RESET}")
    else:
        mostrar_titulo("LISTA DE PEDIDOS")
        if not pedidos:
            print(f"{AMARILLO}No hay pedidos registrados.{RESET}")
        for pedido in pedidos:
            color = COLOR_ESTADO_PEDIDO[pedido["estado"]]
            print(f"ID: {pedido['id']} | Destino: {pedido['destino']} | "
                f"Peso: {pedido['peso']} kg | Prioridad: {pedido['prioridad']} | "
                f"Estado: {color}{pedido['estado']}{RESET} | "
                f"Vehículo: {pedido['vehiculo']}")

def asignar_envio(id_pedido, id_vehiculo):
    pedido = buscar_pedido(id_pedido)
    vehiculo = buscar_vehiculo(id_vehiculo)

    if pedido is None:
        return False, f"El pedido {id_pedido} no existe."
    if vehiculo is None:
        return False, f"El vehículo {id_vehiculo} no existe."
    if pedido["estado"] != "Pendiente":
        return False, (f"El pedido {id_pedido} no está pendiente "
                    f"(estado actual: {pedido['estado']}).")
    if vehiculo["estado"] == "En Ruta":
        return False, (f"El vehículo {id_vehiculo} ya está En Ruta con otro pedido; "
                    f"no puede recibir una nueva asignación.")
    if vehiculo["estado"] != "Disponible":
        return False, (f"El vehículo {id_vehiculo} no está disponible "
                    f"(estado actual: {vehiculo['estado']}).")
    if vehiculo_bloqueado_por_clima(id_vehiculo):
        return False, (f"El vehículo {id_vehiculo} ({vehiculo['tipo']}) está bloqueado "
                    f"por el clima actual: {clima_actual}.")
    if pedido["peso"] > vehiculo["capacidad_maxima"]:
        return False, (f"El peso del pedido ({pedido['peso']} kg) supera la capacidad "
                    f"máxima del vehículo ({vehiculo['capacidad_maxima']} kg).")
    if vehiculo["bateria"] < 20 and pedido["prioridad"] != 5:
        return False, (f"El vehículo {id_vehiculo} tiene batería baja ({vehiculo['bateria']}%) "
                    f"y solo puede aceptar pedidos de prioridad 5 (Emergencia).")

    pedido["estado"] = "En Ruta"
    pedido["vehiculo"] = id_vehiculo
    vehiculo["estado"] = "En Ruta"
    vehiculo["ubicacion_actual"] = f"En camino a {pedido['destino']}"
    return True, (f"Pedido {id_pedido} asignado al vehículo {id_vehiculo}. "
                f"Destino: {pedido['destino']}.")


def simular_clima(nuevo_clima):
    global clima_actual

    if nuevo_clima != "Normal" and nuevo_clima not in restricciones:
        print(f"{ROJO}Clima desconocido: {nuevo_clima}.{RESET}")
        return False

    clima_actual = nuevo_clima
    print(f"{VERDE}El clima ha sido actualizado a: {clima_actual}.{RESET}")

    if nuevo_clima == "Normal":
        return True

    tipo_bloqueado = restricciones[nuevo_clima]

    if tipo_bloqueado is not None:
        # Lluvia / Tormenta: los vehículos del tipo bloqueado que estén En Ruta regresan a base
        penalizacion = PENALIZACIONES.get(nuevo_clima, 0)
        afectados = 0
        for id_vehiculo, datos in flota.items():
            if datos["tipo"] == tipo_bloqueado and datos["estado"] == "En Ruta":
                pedido = buscar_pedido_por_vehiculo(id_vehiculo)
                if pedido is not None:
                    pedido["estado"] = "Pendiente"
                    pedido["vehiculo"] = None
                registrar_consumo(id_vehiculo, penalizacion)
                datos["estado"] = "Disponible"
                datos["ubicacion_actual"] = "Base"
                afectados += 1
                print(f"{AMARILLO}{id_vehiculo} regresa a base: -{penalizacion}% de batería "
                    f"(ahora {datos['bateria']}%). Su pedido vuelve a Pendiente.{RESET}")
        if afectados == 0:
            print(f"{AMARILLO}Ningún {tipo_bloqueado} estaba En Ruta; no hubo cambios.{RESET}")
    else:
        # Calor extremo: nadie regresa, los camiones En Ruta quedan marcados
        marcados = 0
        for id_vehiculo, datos in flota.items():
            if (datos["tipo"] == "Camion" and datos["estado"] == "En Ruta"
                    and id_vehiculo not in camiones_marcados):
                camiones_marcados.append(id_vehiculo)
                marcados += 1
                print(f"{AMARILLO}{id_vehiculo} marcado: consumirá el doble de batería "
                    f"en el próximo avance de tiempo.{RESET}")
        if marcados == 0:
            print(f"{AMARILLO}Ningún camión En Ruta fue marcado.{RESET}")
    return True

def calcular_ruta_eficiente():
    pendientes = []
    for pedido in pedidos:
        if pedido["estado"] == "Pendiente":
            pendientes.append(pedido)

    n = len(pendientes)
    for i in range(n - 1):
        for j in range(n - 1 - i):
            a = pendientes[j]
            b = pendientes[j + 1]
            if (a["prioridad"] < b["prioridad"] or
                    (a["prioridad"] == b["prioridad"] and a["peso"] > b["peso"])):
                pendientes[j] = b
                pendientes[j + 1] = a

    ids_ordenados = []
    for pedido in pendientes:
        ids_ordenados.append(pedido["id"])
    return ids_ordenados

