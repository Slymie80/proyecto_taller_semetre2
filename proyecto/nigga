        "Registrar y visualizar pedidos",
        "Asignar envío",
        "Simular clima",
        "Calcular ruta",
        "Estado de flota",
        "Avance de tiempo",
        "Cargar vehículo",
        "Reporte de eficiencia",
        "Gráficos",
        "Salir"
    ]
    while True:
        mostrar_titulo("Mensajeria Zona Norte")
        print(f"Clima actual: {clima_actual}")
        opcion = seleccionar_opcion(opciones, "Menú principal:")

        if opcion == 1:
            registrar_visualizar_pedidos()
        elif opcion == 2:
            menu_asignar_envio()
        elif opcion == 3:
            menu_simular_clima()
        elif opcion == 4:
            menu_calcular_ruta()
        elif opcion == 5:
            estado_flota()
        elif opcion == 6:
            avance_tiempo()
        elif opcion == 7:
            menu_cargar_vehiculo()
        elif opcion == 8:
            reporte_eficiencia()
        elif opcion == 9:
            graficos()
        elif opcion == 10:
            print(f"{VERDE}Fin del programa{RESET}")
            break

        if opcion != 10:
            input(f"{AMARILLO}Presione Enter para continuar{RESET}")
menu()
