def menu_calcular_ruta():
    mostrar_titulo("RUTA EFICIENTE (PEDIDOS PENDIENTES)")
    ruta = calcular_ruta_eficiente()
    if not ruta:
        print(f"{AMARILLO}No hay pedidos pendientes.{RESET}")
        return
    print("Orden sugerido (mayor prioridad primero; a igual prioridad, menor peso):")
    posicion = 1
    for id_pedido in ruta:
        pedido = buscar_pedido(id_pedido)
        print(f"{posicion}. Pedido {pedido['id']} | {pedido['destino']} | "
            f"Prioridad {pedido['prioridad']} | {pedido['peso']} kg")
        posicion += 1
    print(f"IDs en orden: {ruta}")


