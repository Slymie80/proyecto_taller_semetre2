                    f"Estado: {color}{datos['estado']}{RESET} | "
                    f"Ubicación: {datos['ubicacion_actual']}")
        if not hay:
            print("  (ninguno)")

def avance_tiempo():
    mostrar_titulo("AVANCE DE TIEMPO")
    hubo_cambios = False

    for id_vehiculo, datos in flota.items():
        if datos["estado"] == "En Ruta":
            hubo_cambios = True
            if id_vehiculo in camiones_marcados:
                gasto = 30
            else:
                gasto = 15
            registrar_consumo(id_vehiculo, gasto)
            pedido = buscar_pedido_por_vehiculo(id_vehiculo)

            if datos["bateria"] <= 0:
                datos["bateria"] = 0
                datos["estado"] = "Varado"
                if pedido is not None:
                    datos["ubicacion_actual"] = f"Varado rumbo a {pedido['destino']}"
                    pedido["estado"] = "Pendiente"
                    pedido["vehiculo"] = None
                print(f"{ROJO}{id_vehiculo} se quedó sin batería y quedó Varado. "
                    f"Su pedido vuelve a Pendiente.{RESET}")
            else:
                if pedido is not None:
                    pedido["estado"] = "Entregado"
                    estadisticas_vehiculos[id_vehiculo]["peso_transportado"] += pedido["peso"]
                    datos["ubicacion_actual"] = pedido["destino"]
                    print(f"{VERDE}{id_vehiculo} entregó el pedido {pedido['id']} en "
                        f"{pedido['destino']}. Gastó {gasto}% (batería: {datos['bateria']}%).{RESET}")
                datos["estado"] = "Disponible"

        elif datos["estado"] == "Cargando":
            hubo_cambios = True
            datos["bateria"] = 100
            datos["estado"] = "Disponible"
            datos["ubicacion_actual"] = "Base"
            print(f"{VERDE}{id_vehiculo} completó la carga: batería 100% y Disponible.{RESET}")

    while len(camiones_marcados) > 0:
        camiones_marcados.pop()

    if not hubo_cambios:
        print(f"{AMARILLO}No hay vehículos En Ruta ni Cargando; nada que avanzar.{RESET}")

def cargar_vehiculo(id_vehiculo):
    vehiculo = buscar_vehiculo(id_vehiculo)
    if vehiculo is None:
        return False, f"El vehículo {id_vehiculo} no existe."
    if vehiculo["estado"] == "En Ruta":
        return False, f"El vehículo {id_vehiculo} está En Ruta y no puede ponerse a cargar."
    if vehiculo["estado"] == "Cargando":
        return False, f"El vehículo {id_vehiculo} ya se está cargando."
    vehiculo["estado"] = "Cargando"
    vehiculo["ubicacion_actual"] = "Base"
    return True, (f"El vehículo {id_vehiculo} ahora está Cargando. "
                f"Use 'Avance de tiempo' para completar la carga.")

def reporte_eficiencia():
    mostrar_titulo("REPORTE DE EFICIENCIA (ENERGÍA ACUMULADA)")
    nombres = {"Drone": "Drones", "Moto": "Motos", "Camion": "Camiones"}
    total = 0
    for tipo, energia in consumo_acumulado.items():
        print(f"{nombres[tipo]}: {CYAN}{energia}%{RESET} de batería consumida")
        total += energia
    print(f"{'-' * 40}")
    print(f"Total de la flota: {VERDE}{total}%{RESET}")

def graficos():
    try:
        import matplotlib.pyplot as plt
    except ImportError:
        print(f"{ROJO}No se encontró matplotlib. Instálelo con: pip install matplotlib{RESET}")
        return

    # --- Gráfico 1: peso transportado vs energía consumida por vehículo ---
    plt.figure(1, figsize=(8, 5))
    colores_tipo = {"Drone": "tab:blue", "Moto": "tab:orange", "Camion": "tab:green"}
    for id_vehiculo, stats in estadisticas_vehiculos.items():
        tipo = flota[id_vehiculo]["tipo"]
        plt.scatter(stats["peso_transportado"], stats["energia_consumida"],
                    color=colores_tipo[tipo], s=120)
        plt.annotate(id_vehiculo,
                    (stats["peso_transportado"], stats["energia_consumida"]),
                    textcoords="offset points", xytext=(8, 6))
    for tipo, color in colores_tipo.items():
        plt.scatter([], [], color=color, label=tipo)
    plt.title("Análisis de consumo: peso transportado vs energía consumida")
    plt.xlabel("Peso total transportado acumulado (kg)")
    plt.ylabel("Energía total consumida acumulada (% batería)")
    plt.legend()
    plt.grid(True, alpha=0.3)

    # --- Gráfico 2: capacidad operativa por clima ---
    plt.figure(2, figsize=(7, 5))
    nombres_clima = []
    operativos = []
    for clima, tipo_bloqueado in restricciones.items():
        cantidad = 0
        for datos in flota.values():
            if datos["tipo"] != tipo_bloqueado:
                cantidad += 1
        nombres_clima.append(clima)
        operativos.append(cantidad)
    barras = plt.bar(nombres_clima, operativos, color=["tab:blue", "tab:orange", "tab:red"])
    for barra, valor in zip(barras, operativos):
        plt.text(barra.get_x() + barra.get_width() / 2, valor + 0.05, str(valor),
                ha="center")
    plt.title("Capacidad operativa de la flota por escenario climático")
    plt.xlabel("Clima")
    plt.ylabel("Vehículos que pueden trabajar")
    plt.ylim(0, len(flota) + 1)
    print(f"{VERDE}Mostrando gráficos. Cierre las ventanas para volver al menú.{RESET}")
    plt.show()

